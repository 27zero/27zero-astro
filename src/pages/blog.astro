---
import { sanity } from "../lib/sanity.ts";

const posts = await sanity.fetch(`
  *[_type == "post"] | order(publishedAt desc) {
    _id,
    title,
    slug,
    publishedAt
  }
`);
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Blog</title>
  </head>

  <body>
    <a href="/">Inicio</a>
    <a href="/about/">Sobre mí</a>
    <a href="/blog/">Blog</a>

    <h1>Blog 27zero</h1>

    <ul>
      {
        posts.map((post) => (
          <li>
            <a href={`/blog/${post.slug.current}`}>
              {post.title}
            </a>
          </li>
        ))
      }
    </ul>
  </body>
</html>